{
  "manifest_version": 3,
  "name": "N&T Integration",
  "version": "1.3.8",
  "description": "Send downloads and detected media to the N&T desktop download manager.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "neodm@unlimitedera.com",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "downloads",
    "contextMenus",
    "storage",
    "webRequest",
    "tabs"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "bridge.js",
      "sniff.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "sniff.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "N&T",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  }
}
