<Window Style="{StaticResource {x:Type Window}}" x:Class="NT.App.AddDownloadWindow" Icon="Assets/NT.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add download" Width="580" Height="660" MinHeight="480" MinWidth="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,16,0">
    <StackPanel><TextBlock Text="Add a download" Style="{StaticResource DialogHeading}"/><TextBlock x:Name="Intro" Text="Enter a direct HTTP or HTTPS link to a file, or a magnet: link to a torrent (schedule and speed limit apply to HTTP links only)." Style="{StaticResource Muted}" Margin="0,7,0,20"/></StackPanel>
    <StackPanel Grid.Row="1"><Label Content="Download _URL" Target="{Binding ElementName=UrlInput}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/><TextBox x:Name="UrlInput" AutomationProperties.Name="Download URL"/></StackPanel>
    <StackPanel Grid.Row="2" Margin="0,16,0,0"><Label Content="File _name (optional)" Target="{Binding ElementName=NameInput}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/><TextBox x:Name="NameInput" AutomationProperties.Name="Optional file name"/></StackPanel>
    <StackPanel Grid.Row="3" Margin="0,16,0,0">
      <CheckBox x:Name="ScheduleEnabled" Content="_Schedule for later" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
      <Label Content="Local date and _time (yyyy-MM-dd HH:mm)" Target="{Binding ElementName=ScheduleInput}" Foreground="{DynamicResource InkBrush}"/><TextBox x:Name="ScheduleInput" IsEnabled="{Binding IsChecked, ElementName=ScheduleEnabled}" AutomationProperties.Name="Scheduled local date and time"/>
      <TextBlock Text="Uses this computer's time zone. N&amp;T must be running at the due time." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <Label Content="Speed _limit (KiB/s; blank = unlimited)" Target="{Binding ElementName=SpeedInput}" Foreground="{DynamicResource InkBrush}" Margin="0,12,0,0"/><TextBox x:Name="SpeedInput" AutomationProperties.Name="Speed limit in KiB per second"/>
      <TextBlock Text="Positive whole numbers; shared across this download's segments." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <TextBlock x:Name="ValidationError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12,0,8" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0"/><Button Content="Add download" IsDefault="True" Click="Accept_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
  </Grid>
</Window>