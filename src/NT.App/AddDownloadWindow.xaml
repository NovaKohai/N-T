<Window Style="{StaticResource {x:Type Window}}" x:Class="NT.App.AddDownloadWindow" Icon="Assets/NT.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Add download" Width="580" Height="420" MinHeight="380" MinWidth="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24,22,24,20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,16,0">
    <StackPanel><TextBlock Text="Add a download" Style="{StaticResource DialogHeading}"/><TextBlock x:Name="Intro" Text="Paste a direct HTTP or HTTPS link to a file, or a magnet: link to a torrent." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,18"/></StackPanel>
    <StackPanel><Label Content="Download _URL" Target="{Binding ElementName=UrlInput}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/><TextBox x:Name="UrlInput" AutomationProperties.Name="Download URL" TextChanged="UrlInput_TextChanged"/><TextBlock x:Name="PatternHint" Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Margin="0,16,0,0"><Label Content="File _name (optional)" Target="{Binding ElementName=NameInput}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/><TextBox x:Name="NameInput" AutomationProperties.Name="Optional file name"/></StackPanel>
    <TextBlock x:Name="ValidationError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Assertive"/>
    <Expander x:Name="MoreOptions" Expanded="MoreOptions_Expanded" Header="More _options" Margin="0,6,0,0" AutomationProperties.Name="More options: schedule, speed limit, checksum and queue"><StackPanel Margin="0,2,0,0">
    <StackPanel Margin="0,8,0,0">
      <CheckBox x:Name="ScheduleEnabled" Content="_Schedule for later" Foreground="{DynamicResource InkBrush}" Margin="0,0,0,6"/>
      <Label Content="Local date and _time (yyyy-MM-dd HH:mm)" Target="{Binding ElementName=ScheduleInput}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/><TextBox x:Name="ScheduleInput" IsEnabled="{Binding IsChecked, ElementName=ScheduleEnabled}" AutomationProperties.Name="Scheduled local date and time"/>
      <TextBlock Text="Uses this computer's time zone. N&amp;T must be running at the due time." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      <Label Content="Speed _limit (KiB/s; blank = unlimited)" Target="{Binding ElementName=SpeedInput}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6" Margin="0,14,0,0"/><TextBox x:Name="SpeedInput" AutomationProperties.Name="Speed limit in KiB per second"/>
      <TextBlock Text="Whole numbers only. The limit is shared across this download's connections. Schedule and speed limit apply to HTTP links, not torrents." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel Margin="0,16,0,0">
      <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Label Content="Expected checksum (optional)" Target="{Binding ElementName=ChecksumInput}" Foreground="{DynamicResource InkBrush}" Padding="0"/>
        <ComboBox x:Name="ChecksumAlgo" Grid.Column="1" Width="100" AutomationProperties.Name="Checksum algorithm">
          <ComboBoxItem Content="SHA-256" IsSelected="True" Tag="SHA256"/>
          <ComboBoxItem Content="SHA-1" Tag="SHA1"/>
          <ComboBoxItem Content="MD5" Tag="MD5"/>
        </ComboBox>
      </Grid>
      <TextBox x:Name="ChecksumInput" AutomationProperties.Name="Expected checksum hash"/>
      <TextBlock Text="If you paste the hash published with the file, N&amp;T checks the finished download against it." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel Margin="0,16,0,0">
      <Label Content="Queue _concurrency (applies to the whole queue)" Target="{Binding ElementName=ConcurrentInput}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/>
      <ComboBox x:Name="ConcurrentInput" AutomationProperties.Name="Queue concurrency">
        <ComboBoxItem Content="1 download at a time (Sequential queue)" Tag="1"/>
        <ComboBoxItem Content="2 downloads at a time" Tag="2"/>
        <ComboBoxItem Content="3 downloads at a time (Default)" Tag="3" IsSelected="True"/>
        <ComboBoxItem Content="4 downloads at a time" Tag="4"/>
        <ComboBoxItem Content="5 downloads at a time" Tag="5"/>
        <ComboBoxItem Content="8 downloads at a time" Tag="8"/>
        <ComboBoxItem Content="16 downloads at a time" Tag="16"/>
      </ComboBox>
      <TextBlock Text="How many downloads run at the same time. This changes the setting for every download, not only this one." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    </StackPanel></Expander>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" IsCancel="True" MinWidth="84" Margin="0,0,8,0"/>
      <Button x:Name="DownloadLaterButton" Content="Download _later" Click="DownloadLater_Click" MinWidth="110" Margin="0,0,8,0"/>
      <Button x:Name="AcceptButton" Content="Add download" IsDefault="True" Click="Accept_Click" Style="{StaticResource PrimaryButton}" MinWidth="120"/>
    </StackPanel>
  </Grid>
</Window>