        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/><Setter TargetName="Body" Property="Opacity" Value="0.6"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
