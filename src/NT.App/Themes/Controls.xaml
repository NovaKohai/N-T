  <Style x:Key="FocusRing" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="{DynamicResource ControlRadius}" Margin="-3"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="{DynamicResource ControlPadding}"/><Setter Property="MinHeight" Value="36"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid SnapsToDevicePixels="True">
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource ControlRadius}"/>
        <Border x:Name="HoverOverlay" Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="{DynamicResource ControlRadius}" Opacity="0" IsHitTestVisible="False"/>
        <StackPanel x:Name="Body" Orientation="Horizontal" Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
          <Grid x:Name="GlyphContainer" VerticalAlignment="Center" Margin="0,0,7,0">
            <Border x:Name="BadgeBorder" Background="{Binding Path=(local:Ui.IconBadge), RelativeSource={RelativeSource TemplatedParent}}" Opacity="0.18" CornerRadius="6" Width="26" Height="26"/>
            <Path x:Name="Glyph" Data="{Binding Path=(local:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" Stroke="{Binding Path=(local:Ui.IconBrush), RelativeSource={RelativeSource TemplatedParent}}" Fill="{Binding Path=(local:Ui.IconFill), RelativeSource={RelativeSource TemplatedParent}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="False"/>
          </Grid>
          <!-- The application-wide TextBlock style would otherwise win over the button's own Foreground for plain-text content. -->
          <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"><ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Style></ContentPresenter.Resources></ContentPresenter>
        </StackPanel>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="1.0" Duration="0:0:0.12"/>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Opacity" To="0.0" Duration="0:0:0.15"/>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
        <Trigger Property="local:Ui.Icon" Value="{x:Null}"><Setter TargetName="GlyphContainer" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="local:Ui.IconBadge" Value="{x:Null}"><Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed"/></Trigger>
        <Trigger Property="local:Ui.IconBrush" Value="{x:Null}"><Setter TargetName="Glyph" Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.75"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/><Setter Property="Foreground" Value="{DynamicResource DisabledInkBrush}"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource AccentFillBrush}"/><Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
