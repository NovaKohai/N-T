        <GeometryDrawing Geometry="M16,17 L12,12">
          <GeometryDrawing.Pen><Pen Brush="#1E293B" Thickness="2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M16,17 L21,11">
          <GeometryDrawing.Pen><Pen Brush="#1E293B" Thickness="1.8" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- Center red pivot dot -->
        <GeometryDrawing Brush="#DC2626" Geometry="M16,15.5 A1.5,1.5 0 1,0 16.01,15.5 Z"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

