      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- 4. Stop (Azure blue globe with rainbow arc and red octagonal STOP badge) -->
  <DrawingImage x:Key="DrawingStop">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <!-- Blue globe base -->
        <GeometryDrawing Brush="#3B82F6" Geometry="M12,3 A11,11 0 1,0 12.01,3 Z"/>
        <!-- Globe latitude and longitude curves -->
        <GeometryDrawing Geometry="M1,14 H23 M12,3 C8,8 8,20 12,25 M12,3 C16,8 16,20 12,25">
          <GeometryDrawing.Pen><Pen Brush="#93C5FD" Thickness="1.2"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- Rainbow arc over globe -->
        <GeometryDrawing Geometry="M4,10 C6,4 18,4 20,10">
          <GeometryDrawing.Pen><Pen Brush="#FBBF24" Thickness="1.5"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- Octagonal Red STOP badge in foreground -->
        <GeometryDrawing Brush="#DC2626" Geometry="M17,13 H24 L29,18 V25 L24,30 H17 L12,25 V18 Z"/>
        <GeometryDrawing Geometry="M17,13 H24 L29,18 V25 L24,30 H17 L12,25 V18 Z">
          <GeometryDrawing.Pen><Pen Brush="#FFFFFF" Thickness="1.5"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- Solid white STOP crossbar -->
        <GeometryDrawing Brush="#FFFFFF" Geometry="M15,20 H26 V23 H15 Z"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- 5. Remove (Crimson recycling bin with open tilted lid and falling file) -->
