    <DrawingImage.Drawing>
      <DrawingGroup>
        <!-- Horseshoe magnet body in rich crimson -->
        <GeometryDrawing Brush="#DC2626" Geometry="M6,7 H12 V18 C12,21.3 14.7,24 18,24 C21.3,24 24,21.3 24,18 V7 H30 V18 C30,24.6 24.6,30 18,30 C11.4,30 6,24.6 6,18 Z"/>
        <!-- North pole tip (Silver) -->
        <GeometryDrawing Brush="#E2E8F0" Geometry="M6,7 H12 V12 H6 Z"/>
        <!-- South pole tip (Blue) -->
        <GeometryDrawing Brush="#3B82F6" Geometry="M24,7 H30 V12 H24 Z"/>
        <!-- Magnetic force arcs -->
        <GeometryDrawing Geometry="M9,4 C13,1 23,1 27,4">
          <GeometryDrawing.Pen><Pen Brush="#60A5FA" Thickness="1.6" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- Emerald Plus badge in center -->
        <GeometryDrawing Brush="#10B981" Geometry="M18,11 A5.5,5.5 0 1,0 18.01,11 Z"/>
        <GeometryDrawing Geometry="M18,11 A5.5,5.5 0 1,0 18.01,11 Z">
          <GeometryDrawing.Pen><Pen Brush="#FFFFFF" Thickness="1.2"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M18,8.5 V13.5 M15.5,11 H20.5">
          <GeometryDrawing.Pen><Pen Brush="#FFFFFF" Thickness="1.8" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- 3. Resume (Vibrant Emerald circular button with solid rounded Play arrow) -->
