    <DrawingImage.Drawing>
      <DrawingGroup>
        <!-- Outer emerald circle badge -->
        <GeometryDrawing Brush="#10B981" Geometry="M16,2 A14,14 0 1,0 16.01,2 Z"/>
        <!-- Inner glossy highlight ring -->
        <GeometryDrawing Geometry="M16,3.5 A12.5,12.5 0 1,0 16.01,3.5 Z">
          <GeometryDrawing.Pen><Pen Brush="#34D399" Thickness="1.2"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- Drop shadow for play glyph -->
