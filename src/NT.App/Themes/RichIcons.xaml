          <GeometryDrawing.Pen><Pen Brush="#991B1B" Thickness="1.6" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <!-- Top rim of bin -->
        <GeometryDrawing Brush="#EF4444" Geometry="M7,11 H25 V13.5 H7 Z"/>
        <!-- Yellow document sheet flying inside -->
        <GeometryDrawing Brush="#F59E0B" Geometry="M13,6 L19,3 L21,11 L15,14 Z"/>
        <!-- Open tilted lid in darker red -->
        <GeometryDrawing Brush="#B91C1C" Geometry="M7,10 L23,4 L24,6.5 L8,12.5 Z"/>
        <!-- Lid handle -->
        <GeometryDrawing Brush="#FCA5A5" Geometry="M14,6 L17,4.8 L17.8,6.8 L14.8,8 Z"/>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- 6. Scheduler (Classic retro twin-bell alarm clock in vibrant amber/gold) -->
  <DrawingImage x:Key="DrawingScheduler">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <!-- Twin bells on top -->
        <GeometryDrawing Brush="#D97706" Geometry="M5,4 C7,1 11,4 11,8 L6.5,10 Z"/>
        <GeometryDrawing Brush="#D97706" Geometry="M27,4 C25,1 21,4 21,8 L25.5,10 Z"/>
        <!-- Bell striker handle -->
        <GeometryDrawing Brush="#FCD34D" Geometry="M14,3 H18 V6.5 H14 Z"/>
        <!-- Two clock feet -->
        <GeometryDrawing Brush="#B45309" Geometry="M7,26 L4.5,30 H8 L10.5,27 Z M25,26 L27.5,30 H24 L21.5,27 Z"/>
        <!-- Amber clock outer body -->
        <GeometryDrawing Brush="#F59E0B" Geometry="M16,5 A12,12 0 1,0 16.01,5 Z"/>
        <!-- Crisp white dial face -->
        <GeometryDrawing Brush="#FFFFFF" Geometry="M16,7.5 A9.5,9.5 0 1,0 16.01,7.5 Z"/>
        <!-- Dial hour marks (12, 3, 6, 9) -->
        <GeometryDrawing Brush="#64748B" Geometry="M15.5,8.5 H16.5 V10 H15.5 Z M23,16.5 H24.5 V17.5 H23 Z M15.5,24 H16.5 V25.5 H15.5 Z M7.5,16.5 H9 V17.5 H7.5 Z"/>
