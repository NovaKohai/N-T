<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ===== N&T Rich Vector Iconography: Authentic, colorful, desktop-grade illustrations for toolbar, categories and options ===== -->

  <!-- 1. Add URL (Blue desk tray with falling golden document and emerald plus badge) -->
  <DrawingImage x:Key="DrawingAddUrl">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <!-- Blue desk tray base -->
        <GeometryDrawing Brush="#2563EB" Geometry="M4,18 L10,28 L22,28 L28,18 L24,18 L20,24 L12,24 L8,18 Z"/>
        <!-- Front tray shadow lip -->
        <GeometryDrawing Brush="#1D4ED8" Geometry="M10,24 L12,28 L20,28 L22,24 Z"/>
        <!-- Golden document sheets falling into tray -->
        <GeometryDrawing Brush="#D97706" Geometry="M7,7 L19,3 L23,13 L11,17 Z"/>
        <GeometryDrawing Brush="#FBBF24" Geometry="M9,9 L21,5 L23,15 L11,19 Z"/>
        <!-- Document text lines -->
        <GeometryDrawing Brush="#F59E0B" Geometry="M12,9 L19,7 M12,12 L18,10 M12,15 L16,13.5"/>
        <!-- Emerald Plus Badge in foreground -->
        <GeometryDrawing Brush="#10B981" Geometry="M23,16 A7,7 0 1,0 23.01,16 Z"/>
        <GeometryDrawing Geometry="M23,16 A7,7 0 1,0 23.01,16 Z">
          <GeometryDrawing.Pen><Pen Brush="#FFFFFF" Thickness="1.5"/></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M23,12.5 V19.5 M19.5,16 H26.5">
          <GeometryDrawing.Pen><Pen Brush="#FFFFFF" Thickness="2" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

