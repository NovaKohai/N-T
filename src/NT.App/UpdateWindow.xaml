<Window x:Class="NT.App.UpdateWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="N&amp;T update" Icon="Assets/NT.ico" Width="560" Height="580" MinWidth="480" MinHeight="440" WindowStartupLocation="CenterScreen" ShowInTaskbar="True" FontSize="13">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header Section with App Icon and Version Information -->
    <Grid Grid.Row="0" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- App Icon Card -->
      <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
        <Image Source="Assets/NT.ico" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="N&amp;T icon"/>
      </Border>

      <!-- Title & Subtitle -->
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoftBrush}" CornerRadius="10" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="New Update" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
          </Border>
          <TextBlock x:Name="HeadingText" Style="{StaticResource DialogHeading}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="SubText" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>

    <!-- Release Notes Card Container -->
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
      <DockPanel>
        <!-- Card Header: Title + Links -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10,14,10">
          <DockPanel LastChildFill="True">
            <TextBlock Text="Release notes" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock FontSize="12">
                <Hyperlink x:Name="ChangelogLink" Click="Changelog_Click">View full changelog</Hyperlink>
                <Run Text="   •   " Foreground="{DynamicResource MutedBrush}"/>
                <Hyperlink x:Name="ReleaseLink" Click="Release_Click">Release page</Hyperlink>
              </TextBlock>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Scrollable Release Notes -->
        <ScrollViewer x:Name="NotesScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.Name="Release notes">
          <StackPanel x:Name="NotesPanel" Margin="16,12,16,14"/>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Spacer row -->
    <Grid Grid.Row="2" Margin="0,0,0,0"/>

    <!-- Progress & Status Info -->
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <ProgressBar x:Name="DownloadBar" Maximum="100" Visibility="Collapsed" Height="6" Margin="0,0,0,6"/>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>

    <!-- Footer Action Buttons -->
    <Grid Grid.Row="4" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="SkipButton" Content="_Skip this version" Click="Skip_Click" Margin="0,0,8,0" MinWidth="115" MinHeight="32"/>
        <Button x:Name="LaterButton" Content="Remind me _later" Click="Later_Click" Margin="0,0,8,0" IsCancel="True" MinWidth="115" MinHeight="32"/>
        <Button x:Name="UpdateButton" Content="_Update now" Click="Update_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="120" MinHeight="32"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
