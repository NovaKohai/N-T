<Window x:Class="NT.App.TorrentDetailsWindow" Style="{StaticResource {x:Type Window}}" Icon="Assets/NT.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NT.App" Title="Torrent details" Width="720" Height="600" MinWidth="600" MinHeight="480" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock x:Name="NameText" Style="{StaticResource DialogHeading}" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="PathText" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,12"/>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="Status"/><TextBlock x:Name="StatusText" Grid.Column="1" FontWeight="SemiBold"/>
        <TextBlock Grid.Column="2" Text="Downloaded / selected"/><TextBlock x:Name="SizeText" Grid.Column="3"/>
        <TextBlock Grid.Row="1" Text="Download speed"/><TextBlock x:Name="DownText" Grid.Row="1" Grid.Column="1"/>
        <TextBlock Grid.Row="1" Grid.Column="2" Text="Upload speed"/><TextBlock x:Name="UpText" Grid.Row="1" Grid.Column="3"/>
        <TextBlock Grid.Row="2" Text="Seeds"/><TextBlock x:Name="SeedsText" Grid.Row="2" Grid.Column="1"/>
        <TextBlock Grid.Row="2" Grid.Column="2" Text="Peers"/><TextBlock x:Name="PeersText" Grid.Row="2" Grid.Column="3"/>
        <TextBlock Grid.Row="3" Text="Share ratio (this session)"/><TextBlock x:Name="RatioText" Grid.Row="3" Grid.Column="1"/>
        <TextBlock Grid.Row="3" Grid.Column="2" Text="Connections"/><TextBlock x:Name="ConnectionsText" Grid.Row="3" Grid.Column="3"/>
      </Grid>
      <ProgressBar x:Name="Bar" Maximum="100" Height="8" Margin="0,14,0,5"/>
      <TextBlock x:Name="PercentText" HorizontalAlignment="Right"/>
      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
      <CheckBox x:Name="SequentialCheck" Content="Download in se_quential order (stream / preview files while downloading)" Click="Sequential_Click" Margin="0,6,0,8"/>
      <TextBlock Text="Files" FontWeight="SemiBold" Margin="0,4,0,8"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
      <TextBlock x:Name="Notice" Text="Closing this window does not stop the torrent." Style="{StaticResource Muted}" Margin="0,10" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      <WrapPanel HorizontalAlignment="Right"><Button x:Name="PauseButton" Content="Pause" Click="Pause_Click" Margin="0,0,6,0" MinWidth="80"/><Button Content="_Hide" Click="Hide_Click" MinWidth="80"/></WrapPanel>
    </StackPanel>
    <ListView x:Name="FileList" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Torrent files">
      <ListView.Resources><Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="{DynamicResource SidebarBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Style></ListView.Resources>
      <ListView.ContextMenu>
        <ContextMenu x:Name="FileContextMenu">
          <MenuItem x:Name="MenuPriorityHigh" Header="Priority: _High" Click="FilePriorityHigh_Click"/>
          <MenuItem x:Name="MenuPriorityNormal" Header="Priority: _Normal" Click="FilePriorityNormal_Click"/>
          <MenuItem x:Name="MenuPriorityLow" Header="Priority: _Low" Click="FilePriorityLow_Click"/>
          <MenuItem x:Name="MenuPrioritySkip" Header="Priority: _Do not download (Skip)" Click="FilePrioritySkip_Click"/>
          <Separator/>
          <MenuItem x:Name="MenuFileOpen" Header="_Open file" Click="FileOpen_Click"/>
          <MenuItem x:Name="MenuFileFolder" Header="Open _containing folder" Click="FileOpenFolder_Click"/>
        </ContextMenu>
      </ListView.ContextMenu>
      <ListView.View><GridView>
        <GridViewColumn Header="File" Width="320"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
        <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding Size}"/>
        <GridViewColumn Header="Progress" Width="110"><GridViewColumn.CellTemplate><DataTemplate><Grid Width="90"><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><ProgressBar local:SmoothProgressBar.SmoothValue="{Binding Progress}" Maximum="100" Height="5"/><TextBlock Grid.Column="1" Text="{Binding Percent}" HorizontalAlignment="Right"/></Grid></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
        <GridViewColumn Header="Priority" Width="80" DisplayMemberBinding="{Binding Priority}"/>
      </GridView></ListView.View>
    </ListView>
  </DockPanel>
</Window>
