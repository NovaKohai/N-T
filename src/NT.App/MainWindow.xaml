<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NT.App" Style="{StaticResource {x:Type Window}}" x:Class="NT.App.MainWindow" Icon="Assets/NT.ico" Title="N&amp;T" Width="1180" Height="720" MinWidth="900" MinHeight="480" FontSize="13" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Window.Resources>
    <Style x:Key="Command" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Margin" Value="0,0,2,0"/>
    </Style>
    <Style x:Key="PrimaryCommand" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Padding" Value="{DynamicResource CommandPadding}"/>
      <Setter Property="MinHeight" Value="{DynamicResource CommandMinHeight}"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <!-- Outlined secondary command, used in the selection strip under the queue. -->
    <Style x:Key="StripCommand" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="{DynamicResource CommandPadding}"/>
      <Setter Property="MinHeight" Value="{DynamicResource CommandMinHeight}"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
    </Style>
    <!-- Whole-queue action in the sidebar: a quiet, left-aligned row. -->
    <Style x:Key="SidebarCommand" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="CommandSeparator" TargetType="Border">
      <Setter Property="Width" Value="1"/><Setter Property="Height" Value="18"/><Setter Property="Margin" Value="6,0,8,0"/>
      <Setter Property="Background" Value="{DynamicResource BorderBrush}"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SectionCaption" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="NavCount" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="RowBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource ControlRadius}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
              <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" Padding="4,2" AutomationProperties.Name="Main menu">
      <MenuItem Header="_Tasks">
        <MenuItem Header="_Add URL…" Click="Add_Click" InputGestureText="Ctrl+N"/>
        <MenuItem Header="Add _torrent file…" Click="AddTorrentFile_Click" Tag="torrent"/>
        <MenuItem Header="_Import URLs…" Click="Bulk_Click"/>
        <MenuItem Header="_Host link generator…" Click="LinkGenerator_Click"/>
        <Separator/>
        <MenuItem Header="Start _queue" Click="StartQueue_Click"/>
        <MenuItem Header="Stop q_ueue" Click="StopQueue_Click"/>
        <Separator/>
        <MenuItem Header="_Scheduler…" Click="Schedule_Click" IsEnabled="{Binding IsEnabled, ElementName=ScheduleButton}"/>
        <MenuItem Header="Remove _completed" Click="RemoveCompleted_Click"/>
      </MenuItem>
      <MenuItem Header="_File">
        <MenuItem Header="_Open file…" Click="Open_Click" IsEnabled="{Binding IsEnabled, ElementName=OpenButton}"/>
        <MenuItem Header="Open _folder" Click="Folder_Click" IsEnabled="{Binding IsEnabled, ElementName=FolderButton}"/>
        <Separator/>
        <MenuItem Header="_Minimize to tray" Click="MinimizeToTray_Click"/>
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>
      <MenuItem Header="_Downloads">
        <MenuItem Header="_Resume" Click="Resume_Click" IsEnabled="{Binding IsEnabled, ElementName=ResumeButton}"/>
        <MenuItem Header="_Stop" Click="Stop_Click" IsEnabled="{Binding IsEnabled, ElementName=StopButton}"/>
        <MenuItem Header="Re_move…" Click="Remove_Click" IsEnabled="{Binding IsEnabled, ElementName=RemoveButton}" InputGestureText="Del"/>
        <Separator/>
        <MenuItem Header="Resume all _paused" Click="ResumeAll_Click" IsEnabled="{Binding IsEnabled, ElementName=ResumeAllButton}"/>
        <MenuItem Header="Stop _all" Click="PauseAll_Click" IsEnabled="{Binding IsEnabled, ElementName=PauseAllButton}"/>
        <Separator/>
        <MenuItem x:Name="ProgressMenu" Header="Pro_gress…" Click="Progress_Click"/>
        <MenuItem x:Name="MenuSendToTray" Header="Download in _background (tray)" Click="ContextSendToTray_Click"/>
        <MenuItem Header="Speed _limit…" Click="Speed_Click" IsEnabled="{Binding IsEnabled, ElementName=SpeedButton}"/>
        <Separator/>
        <MenuItem x:Name="MenuClipboardMonitor" Header="Monitor _clipboard" IsCheckable="True" Click="MenuClipboardMonitor_Click"/>
        <MenuItem x:Name="FinishMenu" Header="When downloads _finish"/>
        <MenuItem Header="_Options…" Click="Settings_Click"/>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_All downloads" Click="ViewFilter_Click" Tag="All"/>
        <MenuItem Header="_Downloading" Click="ViewFilter_Click" Tag="Downloading"/>
        <MenuItem Header="_Paused" Click="ViewFilter_Click" Tag="Paused"/>
        <MenuItem Header="_Completed" Click="ViewFilter_Click" Tag="Completed"/>
        <MenuItem Header="_Failed" Click="ViewFilter_Click" Tag="Failed"/>
        <Separator Tag="torrent"/>
        <MenuItem Header="All _torrents" Click="ViewFilter_Click" Tag="T:All"/>
        <MenuItem Header="Torrents downloading" Click="ViewFilter_Click" Tag="T:Downloading"/>
        <MenuItem Header="Torrents _seeding" Click="ViewFilter_Click" Tag="T:Seeding"/>
        <MenuItem Header="Torrents completed" Click="ViewFilter_Click" Tag="T:Completed"/>
        <Separator Tag="torrent"/>
        <MenuItem Header="_Find" Click="Find_Click" InputGestureText="Ctrl+F"/>
        <MenuItem Header="_Refresh" Click="Refresh_Click" InputGestureText="F5"/>
        <Separator/>
        <MenuItem x:Name="ViewMiniWidget" Header="Mini _speed widget" IsCheckable="True" Click="ViewMiniWidget_Click"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Keyboard _shortcuts" Click="Help_Click"/>
        <MenuItem Header="_Check for updates…" Click="CheckUpdates_Click"/>
        <MenuItem Header="_About N&amp;T" Click="About_Click"/>
      </MenuItem>
    </Menu>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="8,6" Background="{DynamicResource SidebarBrush}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Options…" Click="Settings_Click" Style="{StaticResource Command}" Margin="8,0,0,0" VerticalAlignment="Top" local:Ui.Icon="{StaticResource IconSliders}" AutomationProperties.Name="Options" ToolTip="Application options and settings"/>
        <WrapPanel>
          <Button Content="Add _URL…" Click="Add_Click" Style="{StaticResource PrimaryCommand}" local:Ui.Icon="{StaticResource IconPlus}" AutomationProperties.Name="Add URL" ToolTip="Add a download from a link (Ctrl+N)"/>
          <Button x:Name="AddTorrentButton" Content="Add _torrent…" Click="AddTorrentFile_Click" Style="{StaticResource Command}" local:Ui.Icon="{StaticResource IconMagnet}" AutomationProperties.Name="Add torrent" ToolTip="Open and add a torrent file"/>
          <Border Style="{StaticResource CommandSeparator}"/>
          <Button x:Name="ResumeButton" Content="Resume" Click="Resume_Click" Style="{StaticResource Command}" local:Ui.Icon="{StaticResource IconPlay}" AutomationProperties.Name="Resume" ToolTip="Resume the selected download"/>
          <Button x:Name="StopButton" Content="Stop" Click="Stop_Click" Style="{StaticResource Command}" local:Ui.Icon="{StaticResource IconPause}" AutomationProperties.Name="Stop" ToolTip="Pause the selected download; it can be resumed later"/>
          <Button x:Name="RemoveButton" Content="Remove" Click="Remove_Click" Style="{StaticResource Command}" local:Ui.Icon="{StaticResource IconTrash}" AutomationProperties.Name="Remove" ToolTip="Remove the selected download (Delete)"/>
          <Button x:Name="ScheduleButton" Content="Scheduler…" Click="Schedule_Click" Style="{StaticResource Command}" local:Ui.Icon="{StaticResource IconClock}" AutomationProperties.Name="Scheduler" ToolTip="Schedule the selected download for later"/>
          <Border Style="{StaticResource CommandSeparator}"/>
          <Button x:Name="StartQueueButton" Content="Start queue" Click="StartQueue_Click" Style="{StaticResource Command}" local:Ui.Icon="{StaticResource IconQueueStart}" AutomationProperties.Name="Start queue" ToolTip="Start downloading queued items"/>
          <Button x:Name="StopQueueButton" Content="Stop queue" Click="StopQueue_Click" Style="{StaticResource Command}" local:Ui.Icon="{StaticResource IconQueueStop}" AutomationProperties.Name="Stop queue" ToolTip="Stop the queue and pause its active downloads"/>
        </WrapPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,3,6,3">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="DiskSpaceLabel" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,14,0" VerticalAlignment="Center" AutomationProperties.Name="Free disk space"/>
          <TextBlock x:Name="Summary" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,14,0" VerticalAlignment="Center" AutomationProperties.Name="Queue summary"/>
          <TextBlock x:Name="RateLabel" FontSize="12" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="Total transfer speed"/>
          <Border Style="{StaticResource CommandSeparator}" Margin="0,0,4,0"/>
          <Button x:Name="QueueConcurrentButton" Content="Queue: 3 at a time" Click="QueueConcurrentButton_Click" Style="{StaticResource ChipButton}" local:Ui.Icon="{StaticResource IconLayers}" AutomationProperties.Name="Queue concurrency" ToolTip="How many downloads run at the same time"/>
          <Button x:Name="SpeedLimitButton" Content="Speed: Unlimited" Click="SpeedLimitButton_Click" Style="{StaticResource ChipButton}" local:Ui.Icon="{StaticResource IconGauge}" AutomationProperties.Name="Global speed limit" ToolTip="Limit the total download speed"/>
          <Button x:Name="WhenDoneButton" Content="When done: Do nothing" Click="WhenDoneButton_Click" Style="{StaticResource ChipButton}" local:Ui.Icon="{StaticResource IconPower}" AutomationProperties.Name="Action when downloads finish" ToolTip="What N&amp;T does when every download has finished"/>
        </StackPanel>
        <TextBlock x:Name="Notice" Text="Ready" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
      </DockPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="178" MinWidth="150" MaxWidth="320"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="8,12,8,8">
          <TextBlock DockPanel.Dock="Top" Text="DOWNLOADS" Style="{StaticResource SectionCaption}" Margin="10,0,0,8"/>
          <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="2,0,2,8"/>
            <TextBlock Text="WHOLE QUEUE" Style="{StaticResource SectionCaption}" Margin="10,0,0,6"/>
            <Button x:Name="BulkButton" Content="Import URLs…" Click="Bulk_Click" Style="{StaticResource SidebarCommand}" local:Ui.Icon="{StaticResource IconList}" AutomationProperties.Name="Import URLs" ToolTip="Add many links at once, one per line"/>
            <Button x:Name="ResumeAllButton" Content="Resume all paused" Click="ResumeAll_Click" Style="{StaticResource SidebarCommand}" local:Ui.Icon="{StaticResource IconPlay}" AutomationProperties.Name="Resume all paused" ToolTip="Resume every paused download"/>
            <Button x:Name="PauseAllButton" Content="Stop all" Click="PauseAll_Click" Style="{StaticResource SidebarCommand}" local:Ui.Icon="{StaticResource IconPause}" AutomationProperties.Name="Stop all" ToolTip="Pause every active, queued and scheduled download"/>
            <Button x:Name="RemoveCompletedButton" Content="Remove completed" Click="RemoveCompleted_Click" Style="{StaticResource SidebarCommand}" local:Ui.Icon="{StaticResource IconCheckCircle}" AutomationProperties.Name="Remove completed" ToolTip="Clear finished downloads from the list; the files stay on disk"/>
          </StackPanel>
          <ListBox x:Name="Navigation" SelectionChanged="FilterChanged" ItemContainerStyle="{StaticResource NavItem}" AutomationProperties.Name="Download status filters">
            <ListBoxItem Tag="All" IsSelected="True">
              <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource NavCount}"/><TextBlock Text="All downloads" TextTrimming="CharacterEllipsis"/></DockPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Downloading">
              <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource NavCount}"/><TextBlock Text="Downloading" TextTrimming="CharacterEllipsis"/></DockPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Paused">
              <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource NavCount}"/><TextBlock Text="Paused" TextTrimming="CharacterEllipsis"/></DockPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Completed">
              <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource NavCount}"/><TextBlock Text="Completed" TextTrimming="CharacterEllipsis"/></DockPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Failed">
              <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource NavCount}"/><TextBlock Text="Failed" TextTrimming="CharacterEllipsis"/></DockPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Queued">
              <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource NavCount}"/><TextBlock Text="Queued" TextTrimming="CharacterEllipsis"/></DockPanel>
            </ListBoxItem>
            <ListBoxItem Tag="Scheduled">
              <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource NavCount}"/><TextBlock Text="Scheduled" TextTrimming="CharacterEllipsis"/></DockPanel>
            </ListBoxItem>
            <ListBoxItem Tag="header" x:Name="TorrentsHeader" Focusable="False" IsHitTestVisible="False" AutomationProperties.Name="Torrents section">
              <TextBlock Text="TORRENTS" Style="{StaticResource SectionCaption}" Margin="0,10,0,0"/>
            </ListBoxItem>
            <ListBoxItem Tag="T:All">
              <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource NavCount}"/><TextBlock Text="All torrents" TextTrimming="CharacterEllipsis"/></DockPanel>
            </ListBoxItem>
            <ListBoxItem Tag="T:Downloading">
              <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource NavCount}"/><TextBlock Text="Downloading" TextTrimming="CharacterEllipsis"/></DockPanel>
            </ListBoxItem>
            <ListBoxItem Tag="T:Seeding">
              <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource NavCount}"/><TextBlock Text="Seeding" TextTrimming="CharacterEllipsis"/></DockPanel>
            </ListBoxItem>
            <ListBoxItem Tag="T:Completed">
              <DockPanel><TextBlock DockPanel.Dock="Right" Style="{StaticResource NavCount}"/><TextBlock Text="Completed" TextTrimming="CharacterEllipsis"/></DockPanel>
            </ListBoxItem>
          </ListBox>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="0" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" ShowsPreview="False" Panel.ZIndex="10" AutomationProperties.Name="Sidebar width splitter"/>
      <DockPanel Grid.Column="1" Margin="10,0,10,8">
        <Grid DockPanel.Dock="Top" Margin="0,9">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="230"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Heading" Text="All downloads" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="CountLabel" Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0"/>
          <Grid Grid.Column="2">
            <TextBox x:Name="Search" TextChanged="SearchChanged" MinHeight="30" Padding="28,4,8,4" ToolTip="Search file names or URLs (Ctrl+F)" AutomationProperties.Name="Search downloads"/>
            <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock Text="Search downloads" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
        </Grid>
        <Border DockPanel.Dock="Bottom" x:Name="DetailsPanel" Visibility="Collapsed" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="DetailName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DetailPath" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
              </StackPanel>
              <WrapPanel Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Center">
                <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click" Style="{StaticResource StripCommand}" AutomationProperties.Name="Pause selected download" ToolTip="Pause the selected download"/>
                <Button x:Name="SpeedButton" Content="Speed limit…" Click="Speed_Click" Style="{StaticResource StripCommand}" local:Ui.Icon="{StaticResource IconGauge}" AutomationProperties.Name="Set speed limit" ToolTip="Set speed limit for selected download"/>
                <Button x:Name="OpenButton" Content="Open file" Click="Open_Click" Style="{StaticResource StripCommand}" local:Ui.Icon="{StaticResource IconFile}" AutomationProperties.Name="Open file" ToolTip="Open the selected completed file"/>
                <Button x:Name="FolderButton" Content="Open folder" Click="Folder_Click" Style="{StaticResource StripCommand}" local:Ui.Icon="{StaticResource IconFolder}" AutomationProperties.Name="Open folder" ToolTip="Open containing folder"/>
              </WrapPanel>
            </Grid>
            <TextBlock x:Name="DetailTorrent" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" Visibility="Collapsed"/>
            <TextBlock x:Name="DetailError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" MaxHeight="60" Margin="0,5,0,0"/>
          </StackPanel>
        </Border>
        <Grid>
          <ListView x:Name="DownloadList" ItemsSource="{Binding Rows}" SelectionChanged="SelectionChanged" MouseDoubleClick="List_DoubleClick" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="2" VirtualizingPanel.CacheLengthUnit="Page" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Download queue">
            <ListView.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="CtxOpen" Header="_Open" Click="ContextOpen_Click"/>
                <MenuItem x:Name="CtxOpenWith" Header="Open _with…" Click="ContextOpenWith_Click"/>
                <MenuItem x:Name="CtxFolder" Header="Open _folder" Click="ContextFolder_Click"/>
                <MenuItem x:Name="CtxExtract" Header="E_xtract archive…" Click="ContextExtract_Click"/>
                <Separator/>
                <MenuItem x:Name="CtxCopyUrl" Header="Copy _URL (address)" Click="ContextCopyUrl_Click"/>
                <MenuItem x:Name="CtxCopyPath" Header="Copy file _path" Click="ContextCopyPath_Click"/>
                <MenuItem x:Name="CtxMagnet" Header="Copy _magnet link" Click="ContextCopyMagnet_Click"/>
                <MenuItem x:Name="CtxMove" Header="Move / _Rename…" Click="ContextMove_Click"/>
                <MenuItem x:Name="CtxProperties" Header="Propert_ies…" Click="ContextProperties_Click"/>
                <MenuItem x:Name="CtxDetails" Header="Torrent _details…" Click="ContextDetails_Click"/>
                <MenuItem x:Name="CtxSequential" Header="Download in se_quential order" IsCheckable="True" Click="ContextSequential_Click"/>
                <Separator/>
                <MenuItem x:Name="CtxResume" Header="Resu_me" Click="ContextResume_Click"/>
                <MenuItem x:Name="CtxStop" Header="S_top (pause)" Click="ContextStop_Click"/>
                <MenuItem x:Name="CtxSendToTray" Header="Download in _background (tray)" Click="ContextSendToTray_Click"/>
                <MenuItem x:Name="CtxRefreshUrl" Header="Re_fresh address…" Click="ContextRefreshUrl_Click"/>
                <MenuItem x:Name="CtxRedownload" Header="Redo_wnload" Click="ContextRedownload_Click"/>
                <Separator/>
                <MenuItem x:Name="CtxMoveUp" Header="Move _up in queue" Click="MoveUp_Click" InputGestureText="Alt+Up"/>
                <MenuItem x:Name="CtxMoveDown" Header="Move do_wn in queue" Click="MoveDown_Click" InputGestureText="Alt+Down"/>
                <Separator/>
                <MenuItem x:Name="CtxSpeed" Header="Set speed _limit…" Click="Speed_Click"/>
                <MenuItem x:Name="CtxSchedule" Header="Sc_hedule…" Click="Schedule_Click"/>
                <Separator/>
                <MenuItem x:Name="CtxRemove" Header="_Remove…" Click="ContextRemove_Click" InputGestureText="Del"/>
                <MenuItem x:Name="CtxDelete" Header="_Delete from disk…" Click="ContextDelete_Click"/>
              </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
              <GridView AllowsColumnReorder="True">
                <GridViewColumn Width="205">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="Filename" Tag="FileName" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayUrl}"/>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="85" DisplayMemberBinding="{Binding Size}">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="Size" Tag="TotalBytes" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                </GridViewColumn>
                <GridViewColumn Width="108">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="Status" Tag="Status" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,1,7,0" VerticalAlignment="Center" Fill="{DynamicResource MutedBrush}"/>
                        <TextBlock x:Name="StatusLabel" Text="{Binding DisplayStatus}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Downloading"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Connecting"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Checking"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Completed"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Seeding"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Scheduled"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ErrorBrush}"/><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="112">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="Progress" Tag="Progress" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                  <GridViewColumn.CellTemplate>
                    <DataTemplate>
                      <Grid Width="92">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="55"/>
                          <ColumnDefinition Width="37"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar local:SmoothProgressBar.SmoothValue="{Binding Progress}" Maximum="100" Height="6" VerticalAlignment="Center" ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Detail}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Percent}" HorizontalAlignment="Right"/>
                      </Grid>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="90" DisplayMemberBinding="{Binding Remaining}">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="Remaining" Tag="RemainingTime" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                </GridViewColumn>
                <GridViewColumn Width="90" DisplayMemberBinding="{Binding SpeedText}">
                  <GridViewColumn.Header>
                    <GridViewColumnHeader Content="Speed" Tag="Speed" Click="Sort_Click"/>
                  </GridViewColumn.Header>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
          <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30" IsHitTestVisible="False" AutomationProperties.Name="Queue is empty">
            <Path Data="{StaticResource IconDownload}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" HorizontalAlignment="Center" Margin="0,0,0,18"><Path.LayoutTransform><ScaleTransform ScaleX="2.4" ScaleY="2.4"/></Path.LayoutTransform></Path>
            <TextBlock x:Name="EmptyHeading" Text="No downloads" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
            <TextBlock x:Name="EmptyBody" Text="Add a URL or import a list to begin." Style="{StaticResource Muted}" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
