<Window Style="{StaticResource {x:Type Window}}" x:Class="NT.App.DownloadOptionsDialog" Icon="Assets/NT.ico" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Download captured by N&amp;T" Width="580" Height="660" MinHeight="480" MinWidth="520" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,16,0">
    <StackPanel><TextBlock Text="Download captured from browser" Style="{StaticResource DialogHeading}"/><TextBlock Text="Choose how to handle this download in N&amp;T." Style="{StaticResource Muted}" Margin="0,7,0,4"/><TextBlock x:Name="CaptureNote" Text="The browser download has already been stopped. Cancel discards it; if N&amp;T fails, the browser download is restarted." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,20"/></StackPanel>
    <StackPanel><Label Content="Download _URL" Target="{Binding ElementName=UrlDisplay}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/><TextBox x:Name="UrlDisplay" IsReadOnly="True" Background="{DynamicResource SidebarBrush}" AutomationProperties.Name="Download URL"/></StackPanel>
    <StackPanel Margin="0,16,0,0"><Label Content="File _name" Target="{Binding ElementName=NameInput}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/><TextBox x:Name="NameInput" AutomationProperties.Name="File name"/><TextBlock x:Name="DetectedInfo" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.Name="Detected size and type"/></StackPanel>
    <StackPanel Margin="0,16,0,0">
      <Label Content="_Save to" Target="{Binding ElementName=PathInput}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBox x:Name="PathInput" Grid.Column="0" AutomationProperties.Name="Save to path"/>
        <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Click="Browse_Click" MinWidth="84" Margin="8,0,0,0"/>
      </Grid>
    </StackPanel>
    <StackPanel Margin="0,16,0,0">
      <Label Content="_Category" Target="{Binding ElementName=CategoryDropdown}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/>
      <ComboBox x:Name="CategoryDropdown" AutomationProperties.Name="Download category">
        <ComboBoxItem Content="General" Tag="General"/>
        <ComboBoxItem Content="Programs" Tag="Programs"/>
        <ComboBoxItem Content="Compressed" Tag="Compressed"/>
        <ComboBoxItem Content="Documents" Tag="Documents"/>
        <ComboBoxItem Content="Music" Tag="Music"/>
        <ComboBoxItem Content="Video" Tag="Video"/>
      </ComboBox>
    </StackPanel>
    <StackPanel Margin="0,16,0,0">
      <Label Content="Speed _limit (KiB/s; blank = unlimited)" Target="{Binding ElementName=SpeedInput}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/><TextBox x:Name="SpeedInput" AutomationProperties.Name="Speed limit in KiB per second"/>
      <TextBlock Text="Positive whole numbers; shared across this download's segments." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel Margin="0,16,0,0">
      <Label Content="Queue _concurrency (download at the same time)" Target="{Binding ElementName=ConcurrentInput}" Foreground="{DynamicResource InkBrush}" Padding="0,0,0,6"/>
      <ComboBox x:Name="ConcurrentInput" AutomationProperties.Name="Queue concurrency">
        <ComboBoxItem Content="1 download at a time (Sequential queue)" Tag="1"/>
        <ComboBoxItem Content="2 downloads at a time" Tag="2"/>
        <ComboBoxItem Content="3 downloads at a time (Default)" Tag="3" IsSelected="True"/>
        <ComboBoxItem Content="4 downloads at a time" Tag="4"/>
        <ComboBoxItem Content="5 downloads at a time" Tag="5"/>
        <ComboBoxItem Content="8 downloads at a time" Tag="8"/>
        <ComboBoxItem Content="16 downloads at a time" Tag="16"/>
      </ComboBox>
      <TextBlock Text="How many queued files to download at the same time." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel Margin="0,16,0,0" x:Name="SchedulePanel" Visibility="Collapsed">
      <Label Content="Local date and _time (yyyy-MM-dd HH:mm)" Target="{Binding ElementName=ScheduleInput}" Foreground="{DynamicResource InkBrush}"/><TextBox x:Name="ScheduleInput" AutomationProperties.Name="Scheduled local date and time"/>
      <TextBlock Text="Uses this computer's time zone. N&amp;T must be running at the due time." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>
    <TextBlock x:Name="ValidationError" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,12,0,8" AutomationProperties.LiveSetting="Assertive"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Click="Cancel_Click" MinWidth="84" Margin="0,0,8,0"/>
      <Button x:Name="QueueButton" Content="Add to queue" Click="Queue_Click" MinWidth="100" Margin="0,0,8,0"/>
      <Button x:Name="ScheduleButton" Content="Schedule" Click="Schedule_Click" MinWidth="84" Margin="0,0,8,0"/>
      <Button x:Name="StartButton" Content="Start download" Click="Start_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" MinWidth="120"/>
    </StackPanel>
  </Grid>
</Window>
