<Window x:Class="NT.App.AboutWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About N&amp;T" Icon="Assets/NT.ico" Width="540" Height="600" MinWidth="460" MinHeight="460" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="13">
  <Grid Margin="24,22,24,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal">
      <Image Source="Assets/NT.ico" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="N&amp;T icon"/>
      <StackPanel Margin="16,4,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="AppName" Text="N&amp;T" FontSize="26" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" FontSize="14" Margin="0,2,0,0"/>
      </StackPanel>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,18,0,14">
      <TextBlock x:Name="CreatorText" Text="N&amp;T is an open source project created by unlimitedera." TextWrapping="Wrap"/>
      <TextBlock x:Name="LicenseText" Text="Released under the MIT License." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
      <TextBlock Margin="0,6,0,0"><Run Text="Source code: "/><Hyperlink x:Name="RepoLink" NavigateUri="https://github.com/NovaKohai/N-T" Click="Repo_Click">github.com/NovaKohai/N-T</Hyperlink></TextBlock>
    </StackPanel>
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="What's new" FontSize="16" FontWeight="SemiBold" Margin="14,12,14,6"/>
        <ScrollViewer x:Name="ChangelogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.Name="What's new">
          <StackPanel x:Name="ChangelogPanel" Margin="14,0,14,12"/>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Grid Grid.Row="3" Margin="0,16,0,0"><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"><Button x:Name="CheckUpdatesButton" Content="Check for _updates" Click="CheckUpdates_Click" MinWidth="140" MinHeight="32"/><TextBlock x:Name="UpdateStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="230" AutomationProperties.LiveSetting="Polite"/></StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CloseButton" Content="_Close" IsDefault="True" IsCancel="True" MinWidth="96" MinHeight="32" Click="Close_Click"/>
    </StackPanel></Grid>
  </Grid>
</Window>
