<Window x:Class="NT.App.DownloadProgressWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NT.App" Title="Download progress" Width="720" Height="660" MinWidth="600" MinHeight="520" ShowInTaskbar="True" WindowStartupLocation="CenterScreen">
<Grid Margin="14">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition x:Name="DetailsRow" Height="*"/>
  </Grid.RowDefinitions>
  <TabControl x:Name="Tabs" Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="12" AutomationProperties.Name="Download details">
    <TabItem x:Name="StatusTab" Header="Download status" local:Ui.Icon="{StaticResource IconGauge}">
      <Grid Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="FileIconBorder" Background="{DynamicResource AccentSoftBrush}" CornerRadius="{DynamicResource ControlRadius}" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
            <Path x:Name="FileCategoryGlyph" Data="{StaticResource IconFile}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="FileNameHeading" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="UrlText" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>
        <TextBlock Grid.Row="1" Text="Status" Style="{StaticResource Muted}" Margin="0,4,24,4"/><TextBlock x:Name="StatusText" Grid.Row="1" Grid.Column="1" Margin="0,3" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Grid.Row="2" Text="File size" Style="{StaticResource Muted}" Margin="0,4,24,4"/><TextBlock x:Name="SizeText" Grid.Row="2" Grid.Column="1" Margin="0,3"/>
        <TextBlock Grid.Row="3" Text="Downloaded" Style="{StaticResource Muted}" Margin="0,4,24,4"/><TextBlock x:Name="DownloadedText" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
        <TextBlock Grid.Row="4" Text="Transfer rate" Style="{StaticResource Muted}" Margin="0,4,24,4"/><TextBlock x:Name="RateText" Grid.Row="4" Grid.Column="1" Margin="0,3"/>
        <TextBlock Grid.Row="5" Text="Time left" Style="{StaticResource Muted}" Margin="0,4,24,4"/><TextBlock x:Name="TimeLeftText" Grid.Row="5" Grid.Column="1" Margin="0,3"/>
        <TextBlock Grid.Row="6" Text="Resume capability" Style="{StaticResource Muted}" Margin="0,4,24,4"/><TextBlock x:Name="ResumeText" Grid.Row="6" Grid.Column="1" Margin="0,3"/>
        <TextBlock Grid.Row="7" Text="Save path" Style="{StaticResource Muted}" Margin="0,4,24,4"/>
        <DockPanel Grid.Row="7" Grid.Column="1" Margin="0,3" LastChildFill="True">
          <Button Content="Copy" Click="CopyPath_Click" Height="22" Padding="8,1" Margin="8,0,0,0" Style="{StaticResource ToolButton}" ToolTip="Copy destination file path to clipboard"/>
          <TextBlock x:Name="SavePathText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource InkBrush}"/>
        </DockPanel>
      </Grid>
    </TabItem>
    <TabItem x:Name="SpeedTab" Header="Speed limiter" local:Ui.Icon="{StaticResource IconSliders}">
      <StackPanel Margin="0,4,0,0">
        <CheckBox x:Name="LimitCheck" Content="Use speed limit for this download" Checked="Limit_Toggled" Unchecked="Limit_Toggled"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Label Content="Maximum speed (KiB/s)" Target="{Binding ElementName=LimitInput}" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" Margin="0,0,10,0" Padding="0"/><TextBox x:Name="LimitInput" Width="110" AutomationProperties.Name="Speed limit in KiB per second"/><Button x:Name="ApplyLimitButton" Content="_Apply" Click="ApplyLimit_Click" Margin="10,0,0,0" MinWidth="80"/></StackPanel>
        <TextBlock x:Name="LimitMessage" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
    </TabItem>
    <TabItem x:Name="OptionsTab" Header="Options on completion" local:Ui.Icon="{StaticResource IconGear}">
      <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Label Content="Save to:" Target="{Binding ElementName=SaveToText}" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center" Margin="0,0,12,0" Padding="0"/><TextBox x:Name="SaveToText" Grid.Column="1" IsReadOnly="True" AutomationProperties.Name="Save to"/><Button x:Name="ChangeLocationButton" Grid.Column="2" Content="Change save location…" Margin="8,0,0,0" Click="ChangeLocation_Click"/></Grid>
          <TextBlock x:Name="LocationMessage" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
          <CheckBox x:Name="ShowDialogBox" Content="Show download complete dialog" Checked="Options_Changed" Unchecked="Options_Changed"/>
          <CheckBox x:Name="ShowWindowBox" Content="Show this window when the download finishes" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,8,0,0"/>
          <CheckBox x:Name="PlaySoundBox" Content="Play sound when done" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,8,0,0"/>
          <TextBlock x:Name="OptionsNote" Text="These settings are unavailable when &quot;Show download complete dialog&quot; is turned on" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,8"/>
          <CheckBox x:Name="ExitAppBox" Content="Exit N&amp;T when done" Checked="Options_Changed" Unchecked="Options_Changed" Margin="0,0,0,6"/>
          <StackPanel Orientation="Horizontal"><CheckBox x:Name="TurnOffBox" Content="Turn off computer when done" VerticalAlignment="Center" Checked="Options_Changed" Unchecked="Options_Changed"/><ComboBox x:Name="TurnOffKind" Width="140" Margin="16,0,0,0" SelectionChanged="Options_Changed" AutomationProperties.Name="Action when done"/></StackPanel>
          <CheckBox x:Name="ForceBox" Content="Force processes to terminate" Margin="24,6,0,0" Checked="Options_Changed" Unchecked="Options_Changed"/>
          <CheckBox x:Name="RememberBox" Content="Remember this choice for future sessions" Margin="0,12,0,0" Checked="Options_Changed" Unchecked="Options_Changed"/>
        </StackPanel>
        <Button x:Name="HideTabButton" Grid.Column="1" Content="Hide tab" VerticalAlignment="Bottom" Margin="16,0,0,0" MinWidth="110" Click="HideTab_Click"/>
      </Grid>
    </TabItem>
  </TabControl>
  <ProgressBar x:Name="OverallBar" Grid.Row="1" Maximum="100" Height="10" Margin="0,12,0,12" AutomationProperties.Name="Overall download progress"/>
  <Border x:Name="NoticeContainer" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource ControlRadius}" Padding="10,6" Margin="0,0,0,8" Visibility="Collapsed">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Path Data="{StaticResource IconCheckCircle}" Stroke="{DynamicResource SuccessBrush}" StrokeThickness="1.4" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="Notice" Style="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
  </Border>
  <Grid Grid.Row="3" Margin="0,0,0,10">
    <Button x:Name="DetailsButton" Content="Hide details" Click="Details_Click" HorizontalAlignment="Left" MinWidth="130"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="RefreshUrlButton" Content="Re_fresh address…" Click="RefreshUrl_Click" local:Ui.Icon="{StaticResource IconRefresh}" MinWidth="130" Margin="0,0,10,0" Visibility="Collapsed"/>
      <Button x:Name="BackgroundButton" Content="Download in _background" ToolTip="Hide this window to the system tray and continue downloading in the background" Click="Background_Click" local:Ui.Icon="{StaticResource IconTray}" MinWidth="170" Margin="0,0,10,0"/>
      <Button x:Name="PauseButton" Content="Pause" Click="Pause_Click" local:Ui.Icon="{StaticResource IconPause}" MinWidth="100" Margin="0,0,10,0"/>
      <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" MinWidth="100"/>
      <Button x:Name="OpenButton" Content="_Open" Click="Open_Click" Style="{StaticResource PrimaryButton}" local:Ui.Icon="{StaticResource IconFile}" MinWidth="95" Margin="0,0,10,0" Visibility="Collapsed"/>
      <Button x:Name="FolderButton" Content="Open _folder" Click="Folder_Click" local:Ui.Icon="{StaticResource IconFolder}" MinWidth="105" Margin="0,0,10,0" Visibility="Collapsed"/>
      <Button x:Name="CloseButton" Content="_Close" Click="Close_Click" local:Ui.Icon="{StaticResource IconCheckCircle}" MinWidth="90" Visibility="Collapsed"/>
    </StackPanel>
  </Grid>
  <StackPanel x:Name="DetailsPane" Grid.Row="4" Margin="0,4,0,0">
    <TextBlock Text="CONNECTIONS" FontSize="11" FontWeight="SemiBold" Style="{StaticResource Muted}" Margin="0,0,0,6" ToolTip="Start position and progress of each connection"/>
    <Border x:Name="SegmentBarBorder" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource SurfaceBrush}" Height="16" SnapsToDevicePixels="True"><Canvas x:Name="SegmentBar" ClipToBounds="True" SizeChanged="SegmentBar_SizeChanged"/></Border>
    <ListView x:Name="ConnectionList" Height="200" Margin="0,10,0,0" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" AutomationProperties.Name="Connections" SizeChanged="ConnectionList_SizeChanged">
      <ListView.View><GridView><GridViewColumn Header="N." Width="50" DisplayMemberBinding="{Binding Number}"/><GridViewColumn Header="Downloaded" Width="140" DisplayMemberBinding="{Binding Downloaded}"/><GridViewColumn Header="Info" Width="380" DisplayMemberBinding="{Binding Info}"/></GridView></ListView.View>
    </ListView>
  </StackPanel>
</Grid></Window>
