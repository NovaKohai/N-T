<Window x:Class="NT.App.DownloadCompleteWindow" Style="{StaticResource {x:Type Window}}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NT.App" Title="Download complete" Width="580" SizeToContent="Height" MinWidth="500" ResizeMode="CanMinimize" WindowStartupLocation="CenterOwner" ShowActivated="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,20,24,20">
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="{DynamicResource ControlRadius}" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
          <Path x:Name="FileCategoryGlyph" Data="{StaticResource IconFile}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Download complete" Style="{StaticResource DialogHeading}"/>
          <TextBlock x:Name="FileNameLabel" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}" Margin="0,2,0,0"/>
          <TextBlock x:Name="SizeLabel" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>

      <DockPanel Margin="0,0,0,12" LastChildFill="True">
        <Button Content="Copy path" Click="Copy_Click" DockPanel.Dock="Right" Height="28" Padding="10,2" Margin="8,0,0,0" Style="{StaticResource ToolButton}" local:Ui.Icon="{StaticResource IconCopy}" ToolTip="Copy destination file path to clipboard"/>
        <TextBox x:Name="PathLabel" IsReadOnly="True" VerticalAlignment="Center" Background="{DynamicResource SidebarBrush}" AutomationProperties.Name="Saved file path"/>
      </DockPanel>

      <TextBlock x:Name="ChecksumBadge" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" Margin="0,0,0,8" Visibility="Collapsed"/>
      <TextBlock Text="Only open files from sources you trust." Style="{StaticResource Muted}" Margin="0,0,0,6"/>
      <TextBlock x:Name="Notice" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite"/>

      <WrapPanel Margin="0,0,0,12">
        <Button x:Name="OpenButton" Content="_Open" Click="Open_Click" Style="{StaticResource PrimaryButton}" local:Ui.Icon="{StaticResource IconFile}" MinWidth="95" Margin="0,0,8,8"/>
        <Button x:Name="OpenWithButton" Content="Open _with…" Click="OpenWith_Click" local:Ui.Icon="{StaticResource IconExternal}" MinWidth="95" Margin="0,0,8,8"/>
        <Button x:Name="FolderButton" Content="Open _folder" Click="Folder_Click" local:Ui.Icon="{StaticResource IconFolder}" MinWidth="95" Margin="0,0,8,8"/>
        <Button x:Name="ExtractButton" Content="E_xtract…" Click="Extract_Click" local:Ui.Icon="{StaticResource IconPackage}" MinWidth="85" Margin="0,0,8,8"/>
        <Button x:Name="ChecksumButton" Content="Verify _checksum…" Click="Checksum_Click" local:Ui.Icon="{StaticResource IconCheckCircle}" MinWidth="125" Margin="0,0,8,8"/>
      </WrapPanel>

      <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,12"/>

      <Grid>
        <StackPanel VerticalAlignment="Center">
          <CheckBox x:Name="DontShowAgain" Content="Don't show completion dialogs again" Foreground="{DynamicResource InkBrush}" Checked="DontShowAgain_Changed" Unchecked="DontShowAgain_Changed"/>
          <TextBlock Text="You can change this in Options → Downloads." Style="{StaticResource Muted}" FontSize="12" Margin="20,2,0,0"/>
        </StackPanel>
        <Button Content="_Close" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="90" IsDefault="True"/>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Window>
