{
  "manifest_version": 3,
  "name": "N&T Integration",
  "version": "1.3.3",
  "description": "Send downloads and detected media to the N&T desktop download manager.",
  "key": "",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["nativeMessaging", "downloads", "contextMenus", "storage", "webRequest", "tabs"],
  "optional_permissions": ["cookies"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["sniff.js", "content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "action": {
    "default_title": "N&T",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  }
}
