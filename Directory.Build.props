<Project>
  <!-- Single source of truth for the product version (see docs/VERSIONING.md). Used by the app, the native host,
       the installer (build-installer.ps1) and the extension manifest (synced by build.ps1). -->
  <PropertyGroup>
    <Product>N&amp;T</Product>
    <Company>N&amp;T</Company>
    <Version>1.3.1</Version>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <InformationalVersion>1.3.1</InformationalVersion>
    <IncludeSourceRevisionInformation>false</IncludeSourceRevisionInformation>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <WarningsNotAsErrors>NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);NU1900;NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>
</Project>